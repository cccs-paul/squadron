# Squadron Agent Sandbox Image
# Extends workspace-base with OpenCode for agentic AI inside ephemeral containers.
# Rootless: runs as UID 1000 (squadron), read-only root filesystem compatible.
FROM squadron/workspace-base:latest

# Switch to root to install opencode
USER root

# Copy corporate CA certificates if present (for proxy environments)
COPY ca-certs/ /usr/local/share/ca-certificates/custom/
RUN update-ca-certificates 2>/dev/null || true

# Install curl (for health checks) and download opencode binary from GitHub releases
RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends \
        curl \
    && curl -fsSL "https://github.com/anomalyco/opencode/releases/latest/download/opencode-linux-x64.tar.gz" -o /tmp/opencode.tar.gz \
    && tar -xzf /tmp/opencode.tar.gz -C /tmp \
    && mv /tmp/opencode /usr/local/bin/opencode \
    && chmod +x /usr/local/bin/opencode \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/*

# Create config directory writable by squadron user (will be on tmpfs at runtime)
RUN mkdir -p /home/squadron/.config/opencode \
    && chown -R squadron:squadron /home/squadron/.config

# Switch back to rootless user
USER squadron

# Default working directory for agent work
WORKDIR /home/squadron

# Expose OpenCode server port
EXPOSE 4096

# Default: sleep infinity (opencode serve is started via exec after config injection)
CMD ["sleep", "infinity"]
